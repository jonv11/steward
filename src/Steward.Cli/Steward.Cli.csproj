<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Steward.Cli</RootNamespace>
    <AssemblyName>Steward.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>steward</ToolCommandName>
    <PackageId>Steward.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>A configurable repository stewardship CLI for humans and AI agents.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Steward.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward.Core\Steward.Core.csproj" />
  </ItemGroup>

</Project>
