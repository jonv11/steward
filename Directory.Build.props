<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.19.0</Version>
    <AssemblyVersion>0.19.0.0</AssemblyVersion>
    <FileVersion>0.19.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <!-- The release script passes -p:StewardReleaseBuild=true; any other build is a source build and
       `steward version` names its commit (adoption-trial-defects/12). -->
  <ItemGroup>
    <AssemblyMetadata Include="StewardReleaseBuild" Value="$(StewardReleaseBuild)" />
  </ItemGroup>
</Project>
