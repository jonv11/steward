{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/vscode-markdownlint/main/markdownlint-cli2-config-schema.json",
  "gitignore": true,
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    // Generated artifacts are maintained by Steward and should not be hand-edited
    // to satisfy lint-only formatting concerns.
    "STRUCTURE.md",
    "docs/decisions/README.md",

    // Historical evidence under docs/history/** is intentionally excluded from markdown lint.
    // These files are preserved for provenance and traceability, not normalized to the active
    // repo style guide. This is a deliberate preservation exception, not an oversight.
    "docs/history/**/*.md",
    "docs/requirements/master-requirements-source.md",

    // Embedded fixture repositories intentionally model external content and should
    // not participate in repo-document quality gates.
    "tests/Steward.TestFixtures/Repos/**/*.md"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD029": {
      "style": "ordered"
    },
    "MD036": false,
    "MD040": false,
    "MD060": false
  }
}
